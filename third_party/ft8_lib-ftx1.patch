+#ifdef FTX_LDPC_FIXED_POINT
+/* Normalized min-sum for processors without fast floating point. Keep LLRs
+   positive for bit 1, matching bp_decode and the likelihood extractor. */
+void bp_decode(float codeword[], int max_iters, uint8_t plain[], int* ok)
+{
+    int16_t channel[FTX_LDPC_N];
+    int16_t check_to_bit[FTX_LDPC_N][3] = {0};
+    int belief[FTX_LDPC_N];
+    uint8_t edge[FTX_LDPC_M][7];
+    *ok = FTX_LDPC_M;
+
+    for (int n = 0; n < FTX_LDPC_N; ++n)
+    {
+        const float x = codeword[n];
+        channel[n] = x > 16.0f ? 4096 : x < -16.0f ? -4096 : x == x ? (int16_t)(x * 256.0f) : 0;
+    }
+    for (int m = 0; m < FTX_LDPC_M; ++m)
+    {
+        for (int i = 0; i < kFTX_LDPC_Num_rows[m]; ++i)
+        {
+            const int n = kFTX_LDPC_Nm[m][i] - 1;
+            for (int j = 0; j < 3; ++j)
+                if (kFTX_LDPC_Mn[n][j] == m + 1)
+                    edge[m][i] = (uint8_t)j;
+        }
+    }
+
+    for (int iter = 0; iter < max_iters; ++iter)
+    {
+        int ones = 0;
+        for (int n = 0; n < FTX_LDPC_N; ++n)
+        {
+            belief[n] = channel[n] + check_to_bit[n][0] + check_to_bit[n][1] + check_to_bit[n][2];
+            plain[n] = belief[n] > 0;
+            ones += plain[n];
+        }
+        if (!ones)
+            break;
+        const int errors = ldpc_check(plain);
+        if (errors < *ok)
+            *ok = errors;
+        if (!errors)
+            return;
+
+        for (int m = 0; m < FTX_LDPC_M; ++m)
+        {
+            const int row_size = kFTX_LDPC_Num_rows[m];
+            int positive[7];
+            int parity = 0;
+            int min1 = 32767, min2 = 32767, min_index = 0;
+            for (int i = 0; i < row_size; ++i)
+            {
+                const int n = kFTX_LDPC_Nm[m][i] - 1;
+                const int extrinsic = belief[n] - check_to_bit[n][edge[m][i]];
+                positive[i] = extrinsic > 0;
+                parity ^= positive[i];
+                const int magnitude = extrinsic < 0 ? -extrinsic : extrinsic;
+                if (magnitude < min1)
+                {
+                    min2 = min1;
+                    min1 = magnitude;
+                    min_index = i;
+                }
+                else if (magnitude < min2)
+                {
+                    min2 = magnitude;
+                }
+            }
+            for (int i = 0; i < row_size; ++i)
+            {
+                const int n = kFTX_LDPC_Nm[m][i] - 1;
+                const int mag = i == min_index ? min2 : min1;
+                const int scaled = (3 * mag) / 4;
+                check_to_bit[n][edge[m][i]] = (int16_t)((parity ^ positive[i]) ? scaled : -scaled);
+            }
+        }
+    }
+}
